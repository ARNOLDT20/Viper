# VIPER MD example environment variables
# Copy this file to `.env` or use your host's environment settings and adjust values.

# WhatsApp session string (if used)
SESSION_ID=

# Owner phone number in international format (no +)
OWNER_NUMBER=255627417402

# Command prefix (e.g. . or !)
PREFIX=.

# Public mode: true = anyone can use commands, false = owner-only
PUBLIC_MODE=true

# Presence: enable typing/recording notifications (true/false)
PRESENCE=true

# TinyURL / Catbox API keys (if required)
#TINYAPI=
#CATBOX_TOKEN=

# Any other custom keys read by `set.js`
#CUSTOM_KEY=
